# Copie para .env e preencha. NUNCA suba o .env para o repositorio.

# "local" grava em LOCAL_ROOT; "s3" grava direto no data lake da turma (RustFS)
STORAGE=local
LOCAL_ROOT=data_local

# API S3 da turma (NAO e o link do console)
S3_ENDPOINT=https://s3.afonsolelis.tech
S3_REGION=us-east-1
S3_BUCKET=tcg
S3_ACCESS_KEY=
S3_SECRET_KEY=

GROUP_ID=23651
USER_AGENT=colecao-ssp/1.0
