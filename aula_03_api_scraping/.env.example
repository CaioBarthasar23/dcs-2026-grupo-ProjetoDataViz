# Copie para .env e preencha com suas credenciais locais.
# Nunca versione nem compartilhe o arquivo .env.

# MinIO local
MINIO_ROOT_USER=aluno
MINIO_ROOT_PASSWORD=troque-esta-senha

# Cliente S3 usado pelos scripts da aula
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=aluno
S3_SECRET_KEY=troque-esta-senha
S3_REGION=us-east-1
BUCKET_RAW=raw
BUCKET_BRONZE=bronze

# Coletor HTTP
HTTP_TIMEOUT_CONNECT=5
HTTP_TIMEOUT_READ=10
HTTP_MAX_TENTATIVAS=4
HTTP_INTERVALO_MINIMO=1
HTTP_USER_AGENT=aula_03_api_scraping
SCRAPER_CATEGORIAS=
